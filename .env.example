# ─────────────────────────────────────────────────────────────
#  HackerOne API credentials
# ─────────────────────────────────────────────────────────────
#  Copy this file to `.env` (which is git-ignored) and fill in
#  your own values. NEVER commit the real .env.
#
#  Create an API token at:
#    https://hackerone.com/settings/api_token/edit
#
#  The token is used with HTTP Basic auth:  <username>:<token>
# ─────────────────────────────────────────────────────────────

# Your HackerOne username (the account that owns the API token).
H1_USERNAME=your_h1_username

# Your HackerOne API token (treat like a password; rotate if leaked).
H1_API_TOKEN=your_h1_api_token
